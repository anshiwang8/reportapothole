# Municipal email submission pipeline (see app/api/municipal/send/route.ts).
# MUNICIPAL_SEND_ENABLED must be exactly "true" for sending to occur at
# all -- it is the primary safety gate and is intentionally left blank
# here. Do not set it to "true" until the City of Toronto has approved
# programmatic email submission.
MUNICIPAL_SEND_ENABLED=
MUNICIPAL_SEND_SECRET=
MUNICIPAL_TO_EMAIL=
MUNICIPAL_FROM_EMAIL=
RESEND_API_KEY=
